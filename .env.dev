# Development Environment Configuration
# Used with: make dev-up && go run core/cmd/server/main.go

SERVER_ENV=development
APP_PROFILE=default

# Database Configuration (connects to Docker postgres)
# These override values in core/config/default.yaml
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=apprun
DATABASE_PASSWORD=dev_password_123
DATABASE_DB_NAME=apprun_dev

# Legacy variable names (for backward compatibility)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=apprun
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=apprun_dev

# Redis Configuration (connects to Docker redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# TLS Configuration (optional for dev)
SSL_CERT_FILE=
SSL_KEY_FILE=

# JWT Configuration (REQUIRED - must be ≥32 characters)
JWT_SECRET=dev-jwt-secret-must-be-at-least-32-characters-long
JWT_EXPIRY=24h

# Encryption Key (for sensitive data)
ENCRYPTION_KEY=dev-encryption-key-32-chars!!

# Logging
LOG_LEVEL=debug
LOG_FORMAT=text

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
