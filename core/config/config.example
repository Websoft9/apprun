# Configuration Example
# Auto-generated by: make config-example
# DO NOT use in production - customize and rename to config.yaml

# === I18N Module ===
i18n:
  default_language:  # default: en-US, validate: required, db: true
    en-US
  supported_languages:  # default: en-US,zh-CN, validate: required,min=1, db: true
    en-US,zh-CN
  translations_path:  # default: ./locales, validate: required, db: true
    ./locales

# === AUTH Module ===
auth:
  jwt:
    secret: ""  # TODO: Set value
    access_token_expiration: 24h
    refresh_token_expiration: 168h
    issuer: apprun-platform
    audience: apprun-api
    whitelist_paths: []
  security:
    bcrypt_cost: 10
    failed_login_cache_enabled: true
    failed_login_cache_ttl: 5m
    max_failed_attempts: 5

# === SERVER Module ===
server:
  http_port:  # default: 8080, validate: required,min=1,max=5, db: false
    8080
  https_port:  # default: 8443, validate: required,min=1,max=5, db: false
    8443
  ssl_cert_file:  # validate: omitempty,file, db: false
    ""  # TODO: Set value
  ssl_key_file:  # validate: omitempty,file, db: false
    ""  # TODO: Set value
  shutdown_timeout:  # default: 30s, validate: required,min=1s, db: false
    30s
  enable_http_with_https:  # default: true, db: false
    true

# === LOGGER Module ===
logger:
  level:  # default: info, validate: oneof=debug info warn error, db: true
    info
  output:
    targets: stdout

