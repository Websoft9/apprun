# Metrics Module Configuration Example
# This file demonstrates how to configure the metrics collection system

metrics:
  # Collection configuration
  collection:
    enabled: true
    interval: 15s          # How often to collect metrics
    include_runtime: true  # Include Go runtime metrics (goroutines, memory, GC)

  # Cache configuration
  cache:
    enabled: true
    ttl: 1m               # Cache time-to-live (balance real-time vs performance)
    key_prefix: "metrics:"

  # Export configuration (Prometheus)
  export:
    enabled: true
    path: "/metrics"      # HTTP endpoint for Prometheus scraping

  # Rate limiting configuration
  rate_limit:
    enabled: true
    requests: 100         # Max requests per window
    window: 1m            # Time window for rate limiting

  # Tags configuration (Story 9.1)
  tags:
    enabled: true
    
    # Global tags automatically added to all metrics
    # These provide context for multi-dimensional analysis
    global_tags:
      env: production           # Environment identifier
      instance: "${HOSTNAME}"   # Instance identifier (supports env var substitution)
      region: us-east-1         # Geographic region
      cluster: main             # Cluster/deployment group
      version: "1.0.0"          # Application version
    
    # Blacklist: Tag keys that should never be recorded (for security)
    # These typically contain sensitive information
    blacklist:
      - password
      - token
      - secret
      - key
      - credential
      - api_key

# Environment Variable Configuration (Alternative to YAML)
# 
# You can also configure metrics using environment variables:
#
# METRICS_ENV=production              # Environment identifier
# METRICS_INSTANCE_ID=apprun-01       # Instance identifier
# METRICS_TAGS_ENABLED=true           # Enable tags collection
#
# These env vars are read by the MetricsCollector constructor and
# override the YAML configuration.

# Storage Configuration (managed by pkg/metricstore)
# See core/config/metricstore.yaml.example for storage settings
