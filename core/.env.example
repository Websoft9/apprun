# AppRun Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env file to version control

# ============================================================================
# REQUIRED: Database Configuration
# ============================================================================
DATABASE_PASSWORD=dev_password_123

# Optional database overrides (defaults in config/default.yaml)
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=apprun
# DATABASE_DB_NAME=apprun_dev
# DATABASE_DRIVER=postgres

# ============================================================================
# REQUIRED: JWT Secret (must be ≥32 characters)
# ============================================================================
JWT_SECRET=dev-jwt-secret-must-be-at-least-32-characters-long

# Generate secure secret for production:
# openssl rand -base64 32

# ============================================================================
# OPTIONAL: Redis/Cache Configuration
# ============================================================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ============================================================================
# OPTIONAL: Server Configuration
# ============================================================================
# SERVER_HTTP_PORT=8080
# SERVER_HTTPS_PORT=8443
# SERVER_SSL_CERT_FILE=/path/to/cert.pem
# SERVER_SSL_KEY_FILE=/path/to/key.pem

# ============================================================================
# OPTIONAL: Application Settings
# ============================================================================
# CONFIG_DIR=./config
# LOG_LEVEL=info
