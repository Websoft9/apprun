# Environment Variables Example
# Auto-generated by: apprun generate config
# Copy to .env and customize for your environment

# ============================================================================
# Operational Settings (envonly - NOT configurable via YAML)
# ============================================================================

# --- Bootstrap Module ---
# AutoInit - Environment variable only (not in config files) [default: false]
AUTO_INIT=false


# ============================================================================
# Infrastructure Settings (can also use config files)
# ============================================================================
# Uncomment and set as needed to override config file values
# All config file settings can be overridden via environment variables
# Naming convention: UPPERCASE with underscores (e.g., database.host -> DATABASE_HOST)

# --- Metricstore Module ---
# backend [default: mock] (infrastructure)
#METRICSTORE_STORAGE_BACKEND=mock
# timeout [default: 5s]
#METRICSTORE_STORAGE_TIMEOUT=5s
# enabled [default: true]
#METRICSTORE_STORAGE_RETRY_ENABLED=true
# max_attempts [default: 3]
#METRICSTORE_STORAGE_RETRY_MAX_ATTEMPTS=3
# backoff [default: exponential]
#METRICSTORE_STORAGE_RETRY_BACKOFF=exponential
# retention [default: 24h]
#METRICSTORE_STORAGE_RETENTION=24h
# 
#METRICSTORE_STORAGE_=

# --- Metrics Module ---
# enabled [default: true]
#METRICS_COLLECTION_ENABLED=true
# interval [default: 15s]
#METRICS_COLLECTION_INTERVAL=15s
# include_runtime [default: true]
#METRICS_COLLECTION_INCLUDE_RUNTIME=true
# enabled [default: true]
#METRICS_CACHE_ENABLED=true
# ttl [default: 1m]
#METRICS_CACHE_TTL=1m
# key_prefix [default: metrics:] (infrastructure)
#METRICS_CACHE_KEY_PREFIX=metrics:
# enabled [default: true]
#METRICS_EXPORT_ENABLED=true
# path [default: /metrics]
#METRICS_EXPORT_PATH=/metrics
# enabled [default: true]
#METRICS_RATE_LIMIT_ENABLED=true
# requests [default: 100]
#METRICS_RATE_LIMIT_REQUESTS=100
# window [default: 1m]
#METRICS_RATE_LIMIT_WINDOW=1m

# --- Logger Module ---
# level [default: info]
#LOGGER_LEVEL=info
# targets [default: stdout]
#LOGGER_OUTPUT_TARGETS=stdout

# --- Audit Module ---
# enabled [default: true]
#AUDIT_SERVICE_ENABLED=true
# buffer_size [default: 1000]
#AUDIT_SERVICE_BUFFER_SIZE=1000
# worker_count [default: 4]
#AUDIT_SERVICE_WORKER_COUNT=4
# flush_interval [default: 5s]
#AUDIT_SERVICE_FLUSH_INTERVAL=5s
# fallback_file_path [default: /var/log/apprun/audit-fallback.log]
#AUDIT_SERVICE_FALLBACK_FILE_PATH=/var/log/apprun/audit-fallback.log
# enabled [default: true]
#AUDIT_MIDDLEWARE_ENABLED=true
# exclude_paths
#AUDIT_MIDDLEWARE_EXCLUDE_PATHS=
# sensitive_fields
#AUDIT_MIDDLEWARE_SENSITIVE_FIELDS=
# include_request_body [default: false]
#AUDIT_MIDDLEWARE_INCLUDE_REQUEST_BODY=false
# include_response_body [default: false]
#AUDIT_MIDDLEWARE_INCLUDE_RESPONSE_BODY=false
# max_body_size [default: 4096]
#AUDIT_MIDDLEWARE_MAX_BODY_SIZE=4096
# type [default: database]
#AUDIT_STORAGE_TYPE=database
# async_write [default: true]
#AUDIT_STORAGE_ASYNC_WRITE=true
# file_path [default: /var/log/apprun/audit.log]
#AUDIT_STORAGE_FILE_PATH=/var/log/apprun/audit.log
# file_rotate_size [default: 100]
#AUDIT_STORAGE_FILE_ROTATE_SIZE=100
# file_rotate_age [default: 7]
#AUDIT_STORAGE_FILE_ROTATE_AGE=7
# enabled [default: false]
#AUDIT_RETENTION_ENABLED=false
# days [default: 365]
#AUDIT_RETENTION_DAYS=365
# archive_enabled [default: false]
#AUDIT_RETENTION_ARCHIVE_ENABLED=false
# archive_path [default: /var/log/apprun/audit-archive]
#AUDIT_RETENTION_ARCHIVE_PATH=/var/log/apprun/audit-archive

# --- I18n Module ---
# default_language [default: en-US]
#I18N_DEFAULT_LANGUAGE=en-US
# supported_languages [default: en-US,zh-CN]
#I18N_SUPPORTED_LANGUAGES=en-US,zh-CN
# translations_path [default: ./locales]
#I18N_TRANSLATIONS_PATH=./locales

# --- Auth Module ---
# secret (infrastructure)
#AUTH_JWT_SECRET=
# access_token_expiration [default: 24h]
#AUTH_JWT_ACCESS_TOKEN_EXPIRATION=24h
# refresh_token_expiration [default: 168h]
#AUTH_JWT_REFRESH_TOKEN_EXPIRATION=168h
# issuer [default: apprun-platform] (infrastructure)
#AUTH_JWT_ISSUER=apprun-platform
# audience [default: apprun-api] (infrastructure)
#AUTH_JWT_AUDIENCE=apprun-api
# whitelist_paths
#AUTH_JWT_WHITELIST_PATHS=
# bcrypt_cost [default: 10]
#AUTH_SECURITY_BCRYPT_COST=10
# failed_login_cache_enabled [default: true]
#AUTH_SECURITY_FAILED_LOGIN_CACHE_ENABLED=true
# failed_login_cache_ttl [default: 5m]
#AUTH_SECURITY_FAILED_LOGIN_CACHE_TTL=5m
# max_failed_attempts [default: 5]
#AUTH_SECURITY_MAX_FAILED_ATTEMPTS=5
# username [default: admin]
#AUTH_INIT_USERNAME=admin
# email [default: admin@example.com]
#AUTH_INIT_EMAIL=admin@example.com
# password
#AUTH_INIT_PASSWORD=

# --- Database Module ---
# driver [default: postgres] (infrastructure)
#DATABASE_DRIVER=postgres
# host [default: localhost] (infrastructure)
#DATABASE_HOST=localhost
# port [default: 5432] (infrastructure)
#DATABASE_PORT=5432
# user [default: postgres] (infrastructure)
#DATABASE_USER=postgres
# password (infrastructure)
#DATABASE_PASSWORD=
# db_name [default: apprun] (infrastructure)
#DATABASE_DB_NAME=apprun
# auto_migrate [default: false] (infrastructure)
#DATABASE_AUTO_MIGRATE=false

# --- Cache Module ---
# host [default: localhost] (infrastructure)
#CACHE_HOST=localhost
# port [default: 6379] (infrastructure)
#CACHE_PORT=6379
# password (infrastructure)
#CACHE_PASSWORD=
# db [default: 0] (infrastructure)
#CACHE_DB=0
# pool_size [default: 10] (infrastructure)
#CACHE_POOL_SIZE=10
# timeout [default: 2s] (infrastructure)
#CACHE_TIMEOUT=2s
# max_retries [default: 3] (infrastructure)
#CACHE_MAX_RETRIES=3
# fail_open [default: true] (infrastructure)
#CACHE_FAIL_OPEN=true
# tls_enabled [default: false] (infrastructure)
#CACHE_TLS_ENABLED=false

# --- Server Module ---
# http_port [default: 8080] (infrastructure)
#SERVER_HTTP_PORT=8080
# https_port [default: 8443] (infrastructure)
#SERVER_HTTPS_PORT=8443
# ssl_cert_file (infrastructure)
#SERVER_SSL_CERT_FILE=
# ssl_key_file (infrastructure)
#SERVER_SSL_KEY_FILE=
# shutdown_timeout [default: 30s] (infrastructure)
#SERVER_SHUTDOWN_TIMEOUT=30s
# enable_http_with_https [default: true] (infrastructure)
#SERVER_ENABLE_HTTP_WITH_HTTPS=true

