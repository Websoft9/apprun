# apprun-base: Pre-built dependency cache layer
# Purpose: Cache Go modules to speed up incremental builds
# Rebuild frequency: Weekly or when go.mod changes

# ============================================
# Stage 1: Download dependencies only
# ============================================
FROM golang:1.24-alpine AS deps

# Build arguments for multi-architecture support
ARG TARGETARCH
ARG TARGETOS=linux

# Set build environment
ENV GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=${TARGETARCH:-amd64}

# Use TUNA mirror for faster package downloads
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    ca-certificates \
    tzdata

# Set working directory
WORKDIR /build

# Copy go module files only (for layer caching)
COPY core/go.mod core/go.sum ./

# Download all Go dependencies
RUN go mod download && go mod verify

# ============================================
# Stage 2: Clean base with only compiled cache
# ============================================
FROM --platform=${TARGETOS}/${TARGETARCH} golang:1.24-alpine

# Build arguments for multi-architecture support
ARG TARGETARCH
ARG TARGETOS=linux

LABEL maintainer="Websoft9 <help@websoft9.com>"
LABEL org.opencontainers.image.source="https://github.com/Websoft9/apprun"
LABEL org.opencontainers.image.description="AppRun base image with pre-installed Go dependencies"

# Set build environment
ENV GOPROXY=https://goproxy.cn,https://proxy.golang.org,direct \
    CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=${TARGETARCH:-amd64}

# Use TUNA mirror
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.tuna.tsinghua.edu.cn/g' /etc/apk/repositories

# Install build dependencies
RUN apk add --no-cache \
    git \
    make \
    ca-certificates \
    tzdata \
    curl

# Copy ONLY the downloaded dependencies (not source code)
COPY --from=deps /go/pkg /go/pkg

# Download Atlas CLI binary directly from official releases
# Avoids 'unknown/unknown' platform issues from Docker image
RUN ATLAS_ARCH=$(case ${TARGETARCH:-amd64} in \
        amd64) echo "amd64" ;; \
        arm64) echo "arm64" ;; \
        *) echo "amd64" ;; \
    esac) && \
    echo "📥 Downloading Atlas CLI for linux-${ATLAS_ARCH}..." && \
    curl -sSL -o /go/bin/atlas \
        "https://release.ariga.io/atlas/atlas-linux-${ATLAS_ARCH}-latest" && \
    chmod +x /go/bin/atlas && \
    /go/bin/atlas version && \
    echo "✅ Atlas CLI installed successfully"

# Set working directory
WORKDIR /build

# Verify dependencies and Atlas
RUN echo "✅ Go dependencies cached successfully" && \
    echo "✅ Target architecture: ${TARGETARCH:-amd64}" && \
    echo "✅ Atlas CLI: $(/go/bin/atlas version)"

# Image metadata
ARG BUILD_DATE
ARG VERSION=latest
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.version="${VERSION}"

# Default command (for verification)
CMD ["go", "version"]
